# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: used at sign-in to link the Google account to its roster row, and by the seed scripts. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# Local Supabase only (`supabase start`); hosted projects set these in the dashboard.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
